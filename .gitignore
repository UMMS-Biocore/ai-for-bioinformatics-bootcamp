.DS_Store

# Registration form design, setup notes, and any exported response data.
# Responses contain participant names and emails and must never enter git.
registration/
.playwright-mcp/

# Instructor-only notes, deploy docs, registration backend, drafts. Never public.
internal/

# Datasets served by the site (large; deployed by rsync like the videos, not tracked).
site/data/

# Eric Ma's marimo notebooks, exported from the UMMS-Biocore fork (generated; see CLAUDE.md).
site/ired-88/notebooks/

# Members area: JNK liver and ZAKα material, behind the same sign-in as the
# videos. Lives only on this Mac and the server; built by
# internal/site/private/build_private.py. Never commit.
site/private/

# Recordings are deployed by rsync, never tracked.
site/videos/**/*.mp4
# Public how-to clips, also deployed by rsync. Not sign-in gated.
site/howto/*.mp4
